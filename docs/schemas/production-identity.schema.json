{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://younew.nl/schemas/production-identity.schema.json",
  "title": "YouNew production identity observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "environment",
    "origin",
    "observedAt",
    "provider",
    "source",
    "verification",
    "versionReconciliation",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "production_identity_observation" },
    "environment": { "const": "production" },
    "origin": { "const": "https://younew.nl" },
    "observedAt": { "type": "string", "format": "date-time" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sitesVersion"],
      "properties": {
        "name": { "const": "OpenAI Sites / Cloudflare" },
        "sitesVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commitSha", "commitUrl"],
      "properties": {
        "repository": { "const": "https://github.com/zq87xf5jyp-arch/YouNew.git" },
        "branch": { "const": "main" },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "commitUrl": { "type": "string", "format": "uri" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "providerDeploymentRecordHasSourceSha",
        "serviceWorkerCacheVersion",
        "artifactSubsetSha256",
        "artifacts"
      ],
      "properties": {
        "level": { "const": "artifact_subset_match" },
        "providerDeploymentRecordHasSourceSha": { "const": false },
        "serviceWorkerCacheVersion": { "type": "string", "pattern": "^younew-web-[a-f0-9]{12}$" },
        "artifactSubsetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "sourceEvidence"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "sourceEvidence": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["commit_blob", "clean_build"] },
                  "repositoryPath": { "type": "string" },
                  "templatePath": { "type": "string" },
                  "buildCommand": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "versionReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditInputLabel", "sameNamespace", "decision", "explanation"],
      "properties": {
        "auditInputLabel": { "const": 54 },
        "sameNamespace": { "const": false },
        "decision": { "const": "not_comparable" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
