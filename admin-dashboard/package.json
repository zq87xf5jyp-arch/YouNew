{
  "name": "younew-admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "pnpm generate:runtime && node node_modules/next/dist/bin/next build",
    "build:hostinger": "node scripts/verify-packaged-governed-runtime.mjs && node node_modules/next/dist/bin/next build",
    "generate:runtime": "node scripts/generate-governed-runtime.mjs",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js src next.config.ts --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e:admin": "playwright test --config playwright.config.ts",
    "test:e2e:admin:isolated": "E2E_REPORT_PATH=e2e-reports/admin-e2e-demo.json E2E_MUTATION_MODE=isolated E2E_ISOLATED_PROFILE=demo playwright test --config playwright.config.ts --grep-invert 'missing authentication configuration' && E2E_REPORT_PATH=e2e-reports/admin-e2e-closed.json E2E_MUTATION_MODE=isolated E2E_ISOLATED_PROFILE=closed playwright test --config playwright.config.ts --grep 'missing authentication configuration'",
    "test:e2e:admin:production": "E2E_MUTATION_MODE=production playwright test --config playwright.config.ts",
    "backup": "sh scripts/backup-postgres.sh",
    "restore:verify": "sh scripts/restore-postgres.sh",
    "restore:rehearsal": "sh scripts/restore-rehearsal.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
