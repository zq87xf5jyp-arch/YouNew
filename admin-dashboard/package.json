{
  "name": "younew-admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm generate:runtime && node node_modules/next/dist/bin/next dev",
    "build": "pnpm generate:runtime && node node_modules/next/dist/bin/next build",
    "build:hostinger": "pnpm generate:runtime && node scripts/verify-packaged-governed-runtime.mjs && pnpm verify:generated-truth && node node_modules/next/dist/bin/next build",
    "generate:runtime": "node scripts/generate-governed-runtime.mjs && node scripts/generate-canonical-admin-data.mjs && node scripts/generate-release-truth.mjs",
    "verify:generated-truth": "node scripts/generate-canonical-admin-data.mjs --check && node scripts/generate-release-truth.mjs --check",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js src next.config.ts --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "pnpm generate:runtime && node --test tests/*.test.ts",
    "test:e2e:admin": "playwright test --config playwright.config.ts",
    "test:e2e:admin:isolated": "pnpm test:e2e:admin:isolated:roles && pnpm test:e2e:admin:isolated:closed",
    "test:e2e:admin:isolated:roles": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54329 NEXT_PUBLIC_SUPABASE_ANON_KEY=isolated-e2e-anon-key YOUNEW_ADMIN_DEMO_MODE=false pnpm build && for role in owner editor qa viewer; do E2E_REPORT_PATH=e2e-reports/admin-e2e-demo-$role.json E2E_MUTATION_MODE=isolated E2E_ISOLATED_PROFILE=demo E2E_ISOLATED_ROLE=$role playwright test --config playwright.config.ts --grep-invert 'missing authentication configuration' || exit 1; done",
    "test:e2e:admin:isolated:closed": "NEXT_PUBLIC_SUPABASE_URL='' NEXT_PUBLIC_SUPABASE_ANON_KEY='' YOUNEW_ADMIN_DEMO_MODE=false pnpm build && E2E_REPORT_PATH=e2e-reports/admin-e2e-closed.json E2E_MUTATION_MODE=isolated E2E_ISOLATED_PROFILE=closed E2E_ISOLATED_ROLE=viewer playwright test --config playwright.config.ts --grep 'missing authentication configuration'",
    "test:e2e:admin:production": "E2E_MUTATION_MODE=production playwright test --config playwright.config.ts",
    "test:e2e:search:production": "node scripts/production-search-smoke.mjs",
    "sync:app-store": "node scripts/sync-app-store-analytics.mjs",
    "backup": "bash scripts/backup-postgres.sh",
    "backup:storage": "bash scripts/backup-storage.sh",
    "restore:storage:verify": "bash scripts/verify-storage-backup.sh",
    "storage:inventory": "bash scripts/storage-inventory.sh",
    "restore:verify": "bash scripts/restore-postgres.sh",
    "restore:rehearsal": "bash scripts/restore-rehearsal.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
