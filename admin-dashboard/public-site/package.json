{
  "name": "younew-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm generate:runtime && node node_modules/next/dist/bin/next dev",
    "dev:lan": "pnpm generate:runtime && node node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3001",
    "build": "bash scripts/build.sh",
    "build:sites": "bash scripts/build-sites.sh",
    "start": "node scripts/preview.mjs",
    "generate:content": "node scripts/generate-public-content.mjs",
    "generate:geography": "node scripts/generate-netherlands-geography.mjs",
    "generate:runtime": "node ../scripts/generate-governed-runtime.mjs && node ../scripts/generate-canonical-admin-data.mjs && node scripts/generate-public-content.mjs && node ../scripts/generate-release-truth.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js src --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "pnpm generate:runtime && node --test tests/*.test.ts",
    "qa:search": "node scripts/search-qa-matrix.mjs",
    "qa:monetization": "node scripts/monetization-phase0-query-scorecard.mjs",
    "qa:monetization:private": "node scripts/monetization-gate1-private-scorecard.mjs",
    "qa:production-identity": "node scripts/check-production-identity.mjs",
    "qa:production-identity:live": "node scripts/check-production-identity.mjs --live",
    "audit:ia": "node scripts/audit-information-architecture.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:security": "node scripts/check-security.mjs",
    "predeploy:check": "bash scripts/pre-deploy.sh",
    "audit:indexable-value": "python3 ../../scripts/audit-phase6-indexable-value.py",
    "predeploy:controlled-launch": "pnpm predeploy:check && python3 ../../scripts/audit-phase6-indexable-value.py --require-all-pass"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "2.108.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
